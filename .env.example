# Copier en .env (jamais commité). L'application démarre même sans clé (mode dégradé).

# --- Modèle d'IA principal : Grok (xAI) / Groq avec repli automatique ---
# Renseignez votre clé GROK_API_KEY (xAI) ou GROQ_API_KEY (Groq Cloud) ; les fournisseurs sans clé sont ignorés.
# Ordre d'essai (bascule automatique si le premier est indisponible ou dépasse son quota) :
LLM_PROVIDERS=groq,grok,gemini,openai,openrouter,ollama,anthropic

# xAI Grok : https://console.x.ai (Moteur principal Grok)
GROK_API_KEY=
GROK_MODEL=grok-3-mini
# Groq Cloud : https://console.groq.com/keys (Ultra-rapide, supporte aussi les clés gsk_...)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio : https://aistudio.google.com/apikey (Relais de secours gratuit)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Réglages Groq / gpt-oss-120b (tous facultatifs)
# Autres modèles Groq essayés si le 120b est saturé (le quota tokens/minute est PAR MODÈLE) :
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.3-70b-versatile
# Effort de raisonnement : low (rapide, recommandé) | medium | high
LLM_REASONING_EFFORT=low
# Délai de lecture maximal d'une réponse, en secondes
LLM_TIMEOUT_SECONDS=90
# Plafond de tokens de la réponse (hors raisonnement) ; marge ajoutée pour le raisonnement
LLM_MAX_OUTPUT_TOKENS=1400
LLM_REASONING_HEADROOM=500

# OpenAI : https://platform.openai.com/api-keys (Relais de secours)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter : https://openrouter.ai/keys (Modèles ":free")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Ollama (modèle local hors-ligne, gratuit sans limite) : ex. OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Anthropic (facultatif)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# PostgreSQL pour le catalogue juridique du RAG (optionnel pendant la migration)
# Exemple : postgresql://postgres:mot_de_passe@localhost:5432/novissi_droit
LEGAL_DATABASE_URL=

SEUIL_RETRIEVAL=0.08
CORS_ORIGINS=http://localhost:5173

# --- Base juridique dynamique ---
SCRAPER_ENABLED=1
REFRESH_HOURS=24
SCRAPER_MAX_PAGES=40
# OCR des PDF scannés pendant la collecte (installer Tesseract sur Windows)
PDF_OCR_ENABLED=1
PDF_OCR_MAX_PAGES=80
TESSERACT_LANG=fra+eng
# Revérifie les documents déjà connus pour détecter les mises à jour.
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_CONTACT=contact@exemple.tg
ADMIN_TOKEN=
# Journal Officiel (site officiel à confirmer au moment de la démo)
JO_BASE_URL=https://jo.gouv.tg
JO_SEEDS=https://jo.gouv.tg/Lois
JO_LINK_PATTERN=\.pdf($|\?)
# La Question de Droit : renseigner l'adresse du site et obtenir l'autorisation de réutilisation
LQD_BASE_URL=https://www.lqdd.org/textes-de-loi
LQD_SEEDS=https://www.lqdd.org/textes-de-loi/
LQD_LINK_PATTERN=/\d{4}/|/textes-de-loi/|/articles?/|/analyses?/|/lois?/|/codes?/|/decrets?/|\.pdf($|\?)

# --- Registre documentaire et collecte ---
# Texte de démonstration (EXEMPLE_FICTIF_*) : auto = seulement si aucun texte officiel n'est disponible ; on ; off
DEMO_MODE=auto
# Un document archivé est recontrôlé (requête conditionnelle ETag) après N jours. Vide = jamais ; SCRAPER_REFETCH=1 = à chaque passe.
SCRAPER_RECHECK_DAYS=7
# Pause de base (secondes) du backoff exponentiel après une erreur temporaire (délai dépassé, 429, 5xx)
SCRAPER_BACKOFF_SECONDS=2
# OTR (avis fonciers, Joomla) : inactif tant que l'adresse n'est pas confirmée avec  bash diagnose.sh <url>
OTR_BASE_URL=
OTR_SEEDS=
OTR_LINK_PATTERN=\.pdf($|\?)|/file(\.html)?($|\?)

# --- Traduction 100 % gratuite Éwé & Kabiyè ---
# Connecteur neuronal Google GTX gratuit (SANS clé API) pour l'Éwé (code 'ee') :
TRANSLATOR_GTX_ENABLED=1
# Optionnel : Clé gratuite Hugging Face (https://huggingface.co/settings/tokens) pour Meta NLLB-200 (Éwé ewe_Latn & Kabiyè kbp_Latn)
HF_API_KEY=
HF_NLLB_MODEL=facebook/nllb-200-distilled-600M
